/* =========================================================
   CSAMBA — AGENDA HOME (versão consolidada)
   ========================================================= */
.agenda-home { min-width: 0; }
.agenda-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
.agenda-heading > a { margin-bottom: 18px; flex: 0 0 auto; color: #287be0; font-size: 13px; font-weight: 700; white-space: nowrap; }
.agenda-heading > a:hover { text-decoration: underline; }

/* Estrutura: conteúdo à esquerda, mapa à direita */
.agenda-shell { display: flex; align-items: stretch; gap: 16px; width: 100%; min-width: 0; }
.agenda-main { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; background: transparent;min-height: 550px;}
.agenda-map-column { position: relative; flex: 0 0 30%; min-width: 0; background: #fff; box-shadow: 0 4px 14px rgb(0 0 0 / 8%); }
.agenda-body { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); flex: 1 1 auto; gap: var(--cs-gap-lg); width: 100%; min-width: 0; align-items: stretch; }

/* Sete dias, sem caixas e sem navegação */
.agenda-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0; flex: 0 0 auto; min-width: 0; margin-bottom: 16px; padding: 0 16px; background: #fff; box-shadow: 0 4px 14px rgb(0 0 0 / 5%); }
.agenda-days .agenda-tab { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 76px; margin: 0; padding: 12px 4px 15px; border: 0; border-bottom: 3px solid transparent; border-radius: 0; background: transparent; color: #202936; font-family: inherit; text-align: center; cursor: pointer; transition: color .2s ease, border-color .2s ease; }
.agenda-days .agenda-tab strong { display: block; font-size: 14px; font-weight: 700; line-height: 1.2; }
.agenda-days .agenda-tab span { display: block; margin-top: 4px; font-size: 12px; line-height: 1.2; }
.agenda-days .agenda-tab:hover { background: transparent; color: #287be0; }
.agenda-days .agenda-tab.is-active { border-bottom-color: #287be0; background: transparent; color: #287be0; }
.agenda-days .agenda-tab:focus-visible { outline: 2px solid #287be0; outline-offset: -2px; }
.agenda-days-prev, .agenda-days-next { display: none; }

/* Coluna de eventos */
.agenda-events { display: flex; flex-direction: column; min-width: 0; padding: 20px 16px 16px; background: #fff; box-shadow: 0 4px 14px rgb(0 0 0 / 8%); }
.agenda-events-heading { margin-bottom: 14px; }
.agenda-events-heading h3, .agenda-featured-heading h3 { margin: 0; color: #202936; font-size: 17px; font-weight: 800; line-height: 1.3; }
.agenda-events-heading p, .agenda-featured-heading p { margin: 4px 0 0; color: #697383; font-size: 12px; line-height: 1.4; }
.agenda-events-list { flex: 1 1 auto; min-height: 0; }
.agenda-events .agenda-event { position: relative; display: grid; grid-template-columns: 60px minmax(0, 1fr) 16px; align-items: center; gap: 12px; width: 100%; min-height: 64px; box-sizing: border-box; margin: 0; padding: 10px 4px; border: 0; border-bottom: 1px solid #e1e5ed; border-radius: 0; background: transparent; color: #222; font-family: inherit; text-align: left; text-decoration: none; cursor: pointer; transition: padding-left .25s ease, background .25s ease; }
.agenda-events .agenda-event:hover { background: #f7f9fc; }
.agenda-events .agenda-event.is-featured-active { padding-left: 16px; border-bottom-color: #d5e3fb; border-radius: 4px; background: #edf4ff; }
.agenda-events .agenda-event.is-featured-active::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 4px; border-radius: 4px 0 0 4px; background: #287be0; }
.agenda-events .agenda-event.is-featured-active .agenda-event-title { color: #174c9b; }
.agenda-events .agenda-event:focus-visible { outline: 2px solid #287be0; outline-offset: -2px; }
.agenda-event-time { align-self: start; color: #287be0; font-size: 13px; font-weight: 700; line-height: 1.4; white-space: nowrap; }
.agenda-event-info { min-width: 0; }
.agenda-event-title { display: block; overflow: hidden; font-size: 13px; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.agenda-event-meta { display: flex; flex-wrap: wrap; align-items: center; margin-top: 4px; color: #697383; font-size: 11px; line-height: 1.4; }
.agenda-event-meta > * + *::before { content: '·'; margin: 0 6px; color: #a0a8b4; }
.agenda-event-arrow { color: #697383; font-size: 22px; line-height: 1; text-align: right; }
.agenda-see-all { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 43px; margin-top: 14px; padding: 10px; background: #edf4ff; color: #174c9b; font-size: 12px; font-weight: 700; line-height: 1.3; text-align: center; transition: background .2s ease; }
.agenda-see-all:hover { background: #dceaff; }

/* Evento em destaque: um evento por slide */
.agenda-featured { display: flex; flex-direction: column; min-width: 0; padding: 20px 16px 16px; background: #fff; border-radius: 6px; box-shadow: 0 4px 14px rgb(0 0 0 / 5%); }
.agenda-featured-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 16px; }
.agenda-featured-controls { display: flex; flex: 0 0 auto; gap: 8px; }
.agenda-featured-prev, .agenda-featured-next, .home-column-prev, .home-column-next { display: flex; align-items: center; justify-content: center; flex: 0 0 34px; width: 34px; height: 34px; padding: 0; border: 1px solid #dce2ed; border-radius: 50%; background: #fff; color: #174c9b; cursor: pointer; font-size: 22px; line-height: 1; }
.agenda-featured-prev:hover, .agenda-featured-next:hover { background: #edf4ff; }
.agenda-featured .swiper-button-disabled { opacity: .35; cursor: default; }
.agenda-featured-swiper { width: 100%; min-width: 0; overflow: hidden; }
.agenda-featured-swiper .swiper-slide { height: auto; }
.agenda-featured-card { display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid #e5e9f0; border-radius: 6px; background: #fff; box-shadow: 0 2px 7px rgb(0 0 0 / 5%); }
.agenda-featured-image { display: block; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; }
.agenda-featured-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
.agenda-featured-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #edf4ff; color: #287be0; font-size: 20px; font-weight: 800; }
.agenda-featured-copy { display: flex; flex-direction: column; flex: 1 1 auto; padding: 16px; }
.agenda-featured-copy h4 { margin: 0 0 12px; color: #202936; font-size: 18px; font-weight: 800; line-height: 1.3; }
.agenda-featured-meta { display: flex; flex-direction: column; gap: 7px; margin-bottom: 12px; color: #697383; font-size: 12px; }
.agenda-featured-description { margin: 0 0 16px; color: #697383; font-size: 13px; line-height: 1.6; }
.agenda-featured-link { align-self: flex-start; margin-top: auto; padding: 10px 14px; border-radius: 4px; background: #287be0; color: #fff; font-size: 12px; font-weight: 700; }
.agenda-featured-pagination { position: relative !important; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 16px; }
.agenda-featured-pagination .swiper-pagination-bullet { width: 8px; height: 8px; margin: 0 !important; background: #cbd3df; opacity: 1; }
.agenda-featured-pagination .swiper-pagination-bullet-active { background: #287be0; }
.agenda-featured-empty, .agenda-loading, .agenda-empty { margin: 0; padding: 30px 0; color: #777; font-size: 13px; line-height: 1.5; text-align: center; }
.agenda-featured-empty[hidden] { display: none; }

/* Mapa e popups Leaflet */
.agenda-map-wrapper { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 550px; }
#agenda-map { width: 100%; height: 100%; min-height: 550px; }
.agenda-open-map { position: absolute; z-index: 500; right: 14px; bottom: 14px; padding: 11px 15px; border: 1px solid #dce2ed; border-radius: 4px; background: rgb(255 255 255 / 96%); color: #174c9b; box-shadow: 0 2px 8px rgb(0 0 0 / 12%); font-size: 12px; font-weight: 700; transition: background .2s ease; }
.agenda-open-map:hover { background: #fff; }
.agenda-map-popup { min-width: 190px; }
.agenda-map-popup h4 { margin: 0 0 10px; color: #174c9b; font-size: 15px; font-weight: 700; }
.agenda-popup-event { padding: 8px 0; border-top: 1px solid #eee; }
.agenda-popup-event strong, .agenda-popup-event span { display: block; margin-bottom: 4px; font-size: 12px; line-height: 1.4; }
.agenda-popup-event a { display: inline-block; margin-top: 4px; color: #287be0; font-size: 11px; font-weight: 700; }
.agenda-popup-event a:hover { text-decoration: underline; }

/* Responsividade */
@media (max-width: 1200px) {
  .agenda-map-column { flex-basis: 28%; }
  .agenda-body { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .agenda-events, .agenda-featured { padding: 16px 12px; }
  .agenda-events-heading h3, .agenda-featured-heading h3 { font-size: 15px; }
  .agenda-featured-copy { padding: 12px; }
  .agenda-featured-copy h4 { font-size: 15px; }
}
@media (max-width: 1000px) {
  .agenda-shell { flex-direction: column; }
  .agenda-main { flex: none; width: 100%; }
  .agenda-body { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  .agenda-map-column { flex: none; width: 100%; height: 320px; }
  .agenda-map-wrapper, #agenda-map { height: 320px; min-height: 320px; }
}
@media (max-width: 650px) {
  .agenda-home { margin-top: 28px; }
  .agenda-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
  .agenda-heading > a { font-size: 12px; }
  .agenda-days { grid-template-columns: repeat(7, minmax(65px, 1fr)); overflow-x: auto; padding: 0 8px; }
  .agenda-days .agenda-tab { min-height: 65px; padding: 10px 2px; }
  .agenda-days .agenda-tab strong { font-size: 12px; }
  .agenda-days .agenda-tab span { font-size: 11px; }
  .agenda-body { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .agenda-events, .agenda-featured { padding: 16px 12px; }
  .agenda-events .agenda-event { grid-template-columns: 42px minmax(0, 1fr) 12px; gap: 7px; min-height: 58px; }
  .agenda-event-time { font-size: 12px; }
  .agenda-event-title { font-size: 13px; }
  .agenda-event-meta { font-size: 11px; }
  .agenda-event-arrow { font-size: 19px; }
  .agenda-see-all { min-height: 42px; font-size: 11px; }
  .agenda-featured-copy h4 { font-size: 16px; }
  .agenda-map-column { height: 300px; }
  .agenda-map-wrapper, #agenda-map { height: 300px; min-height: 300px; }
  .agenda-open-map { right: 10px; bottom: 10px; padding: 9px 12px; font-size: 11px; }
}
@media (prefers-reduced-motion: reduce) {
  .agenda-featured-card, .agenda-events .agenda-event, .agenda-days .agenda-tab { transition: none; }
}
