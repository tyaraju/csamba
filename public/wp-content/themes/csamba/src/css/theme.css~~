/* Archive: bandas e artistas */
.bands-archive {
  --bands-blue: var(--cs-blue, #2879d0);
  --bands-yellow: #ffc331;
  --bands-text: #111820;
  --bands-muted: #606c7c;
  --bands-radius: 6px;

  display: flex;
  flex-direction: column;
  gap: 28px;
  padding-top: 26px;
  padding-bottom: 36px;
  color: var(--bands-text);
}

.bands-archive *,
.bands-archive *::before,
.bands-archive *::after {
  box-sizing: border-box;
}

.bands-archive [hidden] {
  display: none !important;
}

.bands-archive button,
.bands-archive input {
  font: inherit;
}

.bands-archive button {
  cursor: pointer;
}

.bands-archive a {
  text-decoration: none;
}

.bands-archive :is(a, button, input):focus-visible {
