  z-index:2;
  top:50%;
  left:8%;
  display:flex;
  align-items:center;
  justify-content:center;
  width:36px;
  height:36px;
  border:2px solid var(--cs-blue);
  border-radius:50%;
  color:var(--cs-blue);
