  font-weight:400;
  transform:translateY(-100%);
  transition:background .2s ease,color .2s ease;
}
.home-column-category:hover .home-column-category-arrow {
  background:var(--cs-blue);
  color:#fff;
}
.home-column-category-info {
  text-align: center;
}
/* PÀGINA BANDA */
