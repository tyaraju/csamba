}
@media(max-width:900px) {
  .content-columns {
    grid-template-columns:1fr;
  }
  .home-column-featured-overlay {
    width:78%;
  }
}
@media(max-width:600px) {
  .community-cards,
  .home-column-cards {
    grid-template-columns:1fr;
  }
  .community-card {
    min-height:240px;
  }
  .home-column-featured,
  .home-column-featured-overlay {
    min-height:300px;
  }
  .home-column-featured-overlay {
    width:100%;
    padding:18px 18px 38px;
  }
  .home-column-featured-overlay h3 {
    font-size:22px;
  }
  .home-column-featured-image::after {
    background:linear-gradient(0deg,rgba(0,0,0,.88) 0%,rgba(0,0,0,.48) 70%,rgba(0,0,0,.12) 100%);
  }
  .home-column-prev {
    left:18px;
  }
  .home-column-next {
    right:18px;
  }
}
.community-card {
  position:relative;
  isolation:isolate;
  overflow:hidden;
  transition:transform .3s ease,box-shadow .3s ease;
}
.community-card::before {
  content:"";
  position:absolute;
  inset:0;
  z-index:-1;
  background-image:var(--community-bg);
  background-size:cover;
  background-position:center;
  transition:transform .5s ease;
}
.community-card:hover {
  transform:translateY(-4px);
  box-shadow:0 10px 24px rgba(0,0,0,.18);
}
.community-card:hover::before {
  transform:scale(1.06);
}
@media (prefers-reduced-motion:reduce) {
  .community-card,.community-card::before {
    transition:none;
  }
}
/* Colunas - categorias */
.home-column-categories {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:var(--cs-gap);
}
.home-column-category {
  display:flex;
  flex-direction:column;
  min-width:0;
  overflow:hidden;
  background:#fff;
  box-shadow:var(--cs-shadow);
  color:#101d39;
  transition:transform .25s ease,box-shadow .25s ease;
}
.home-column-category:hover {
  transform:translateY(-4px);
  box-shadow:0 8px 20px rgba(0,0,0,.15);
}
.home-column-category-image {
  position:relative;
  display:block;
  width:100%;
  aspect-ratio:3/2;
  overflow:hidden;
}
.home-column-category-image img {
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  opacity:1;
  visibility:visible;
  transition:transform .3s ease;
}
.home-column-category:hover .home-column-category-image img {
